# ---------------------------------------------------------------------------
# Sentinel credentials. Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

# --- Trust Wallet Agent Kit (TWAK) ---  from portal.trustwallet.com
TWAK_ACCESS_ID=
TWAK_HMAC_SECRET=
# The non-custodial agent wallet TWAK creates/manages for autonomous signing.
TWAK_AGENT_WALLET_ADDRESS=

# --- CoinMarketCap AI Agent Hub ---  from coinmarketcap.com/api/agent
CMC_API_KEY=
# x402 endpoint for pay-per-request data (filled from the portal's MCP config).
CMC_X402_ENDPOINT=

# --- BNB Chain / BSC ---
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
BSC_CHAIN_ID=56
# Competition registration contract (from the rules).
COMPETITION_CONTRACT=0x212c61b9b72c95d95bf29cf032f5e5635629aed5

# --- bnbagent-sdk (ERC-8004 identity) ---
# Agent identity metadata; agentId is written back after registration.
AGENT_NAME=Sentinel
AGENT_ID=
